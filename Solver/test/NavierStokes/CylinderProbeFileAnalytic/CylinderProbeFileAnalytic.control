Flow equations        = "NS"
mesh file name        = "../../TestMeshes/CylinderNSpol3.mesh"
Polynomial order      = 3
Number of time steps  = 0
Output Interval       = 10
Number of plot points = 5
Convergence tolerance = 1.d-10
cfl                   = 0.3
dcfl                  = 0.3
mach number           = 0.3
Reynolds number       = 200.0
interface width (dimensionless) = 2.0
peclet number = 0.005
AOA theta             = 0.0
AOA phi               = 90.0
solution file name    = "RESULTS/CylinderProbeFileAnalytic.hsol"
save gradients with solution = .true.
restart               = .false.
restart file name     = "RESULTS/CylinderProbeFileAnalytic.hsol"
riemann solver        = roe

#define boundary InnerCylinder
  type = NoSlipWall
#end

#define boundary bottom__top
  type = FreeSlipWall
#end

#define boundary back__left__front
  type = Inflow
#end

#define boundary right
  type = Outflow
#end

! Bulk "probe file" block: exercises InitializeProbesFromFile, cross-rank
! ownership resolution (Probe_LookInOtherPartitions) and the SoA file-probe
! update/write path (Monitor_UpdateFileProbes / Monitor_FlushFileProbesNow),
! with ASCII output. All 4 points coincide with the single inline probe
! above, so their "u" value must match wake_u exactly.
#define probe file
   file                 = "./probes_analytic.dat"
   variables            = u v w rho pressure u_x u_y u_z v_x v_y v_z w_x w_y w_z p_x p_y p_z rho_x rho_y rho_z
   probe save timestep  = 0
   output format        = ASCII
#end
