!
!  horses.tools "fwh post": computes the FWH acoustic pressure at the observers from the surface
!  solution saved by CylinderFWH.control (horses3d.ns). Flow parameters, FWH surface and observers
!  must be the same as in CylinderFWH.control. The observers are written with the solution file name
!  of this control file (RESULTS/FWHPost.<observer>.observer), to compare with the on the fly ones.
!  It must be run in serial.
!
tool type             = fwh post
acoustic files pattern = RESULTS/surfaces/CylinderFWH_fwh_*.surf.hsol
has gradients         = .false.

Flow equations        = "NS"
mesh file name        = "../../../TestMeshes/CylinderNSpol3.mesh"
Polynomial order      = 3
mach number           = 0.3
Reynolds number       = 200.0
AOA theta             = 0.0
AOA phi               = 90.0
solution file name    = "RESULTS/FWHPost.hsol"
restart               = .false.
riemann solver        = roe
Discretization nodes  = Gauss

acoustic analogy            = FWH
acoustic analogy permeable  = .false.
acoustic solid surface      = [InnerCylinder]
observers flush interval    = 20

#define acoustic observer 1
   name     = side
   position = [10.0, 0.5, 0.0]
#end

#define acoustic observer 2
   name     = upstream
   position = [0.0, 0.5, -10.0]
#end

#define boundary InnerCylinder
  type = NoSlipWall
#end

#define boundary bottom__top
  type = FreeSlipWall
#end

#define boundary back__left__front
  type = Inflow
#end

#define boundary right
  type = Outflow
#end
