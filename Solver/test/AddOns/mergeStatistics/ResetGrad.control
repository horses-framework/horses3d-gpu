!
!  mergeStatistics CI (with gradients): statistics dumped and reset every 10 iterations (files to merge)
!
Flow equations        = "NS"
mesh file name        = "../../TestMeshes/CylinderNSpol3.mesh"
Polynomial order      = 3
Number of time steps  = 20
Output Interval       = 10
Convergence tolerance = 1.d-10
cfl                   = 0.3
dcfl                  = 0.3
mach number           = 0.3
Reynolds number       = 200.0
AOA theta             = 0.0
AOA phi               = 90.0
solution file name    = "RESULTS/ResetGrad.hsol"
save gradients with solution = .true.
restart               = .false.
restart file name     = "RESULTS/ResetGrad.hsol"
riemann solver        = roe

#define boundary InnerCylinder
  type = NoSlipWall
#end

#define boundary bottom__top
  type = FreeSlipWall
#end

#define boundary back__left__front
  type = Inflow
#end

#define boundary right
  type = Outflow
#end

#define statistics
   Sampling interval  = 1
   Starting iteration = 0
   Reset interval     = 10
#end
