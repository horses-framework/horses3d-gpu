!
!  Short NS cylinder run used to generate the input files for the horses2plt CI:
!     * RESULTS/Cylinder_*.hsol              -> volumetric solution (with gradients)
!     * RESULTS/Cylinder.stats.hsol          -> volumetric statistics
!     * RESULTS/surfaces/*.surf.hsol         -> surface solution on the cylinder wall,
!                                               including u_tau, mu_NS and wall distance
!
Flow equations        = "NS"
mesh file name        = "../../TestMeshes/CylinderNSpol3.mesh"
Polynomial order      = 3
Number of time steps  = 20
Output Interval       = 10
Convergence tolerance = 1.d-10
cfl                   = 0.3
dcfl                  = 0.3
mach number           = 0.3
Reynolds number       = 200.0
AOA theta             = 0.0
AOA phi               = 90.0
solution file name    = "RESULTS/Cylinder.hsol"
save gradients with solution = .true.
autosave mode         = "iteration"
autosave interval     = 10
restart               = .false.
restart file name     = "RESULTS/Cylinder.hsol"
riemann solver        = roe

! -------------------------
! Surfaces
! -------------------------
boundaries to save     = [InnerCylinder]
surface save gradients = .true.
surface save utau      = .true.  ! u_tau -> Cf, wall_shear
surface save turbulent = .true.  ! mu_NS and wall distance -> yplus

#define boundary InnerCylinder
  type = NoSlipWall
#end

#define boundary bottom__top
  type = FreeSlipWall
#end

#define boundary back__left__front
  type = Inflow
#end

#define boundary right
  type = Outflow
#end

#define statistics
   Sampling interval  = 1
   Starting iteration = 0
#end
